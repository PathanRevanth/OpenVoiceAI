# ---------------------------------------------------------------------------
# Voice-First AI — backend (control plane) configuration
# Copy to `backend/.env` and adjust. Every key is optional in demo mode.
# ---------------------------------------------------------------------------

# --- Model gateway ---------------------------------------------------------
# Any pydantic-ai model string: openai:gpt-5.2, anthropic:claude-sonnet-4-5,
# google-gla:gemini-2.5-pro, grok:...  Special value "demo" = scripted offline model.
VOICEFIRST_DEFAULT_MODEL=openai:gpt-5.2
VOICEFIRST_REALTIME_MODEL=openai:gpt-realtime

# Provider keys (also picked up by pydantic-ai from OPENAI_API_KEY etc.)
VOICEFIRST_OPENAI_API_KEY=
VOICEFIRST_ANTHROPIC_API_KEY=
VOICEFIRST_GOOGLE_API_KEY=

# --- Persistence ------------------------------------------------------------
# SQLite by default; use Postgres in production:
# VOICEFIRST_DATABASE_URL=postgresql+asyncpg://voicefirst:voicefirst@db:5432/voicefirst
VOICEFIRST_DATABASE_URL=sqlite+aiosqlite:///./voicefirst.db

# Optional cache/event-bus mirror
VOICEFIRST_REDIS_URL=

# --- Observability ----------------------------------------------------------
# Get a token at logfire.dev — enables OpenTelemetry tracing of every run
VOICEFIRST_LOGFIRE_TOKEN=
VOICEFIRST_LOGFIRE_ENVIRONMENT=local

# --- Governance / safety ----------------------------------------------------
# Roles: viewer < ops < admin. Mutating tools need ops+; destructive need admin.
VOICEFIRST_MUTATING_MIN_ROLE=ops
# Route every mutating tool call through human approval
VOICEFIRST_REQUIRE_APPROVAL_FOR_MUTATIONS=true
# Pause runs until the operator approves the orchestrator's plan (AI Elements
# plan card in the chat). Set false to let runs delegate immediately.
VOICEFIRST_REQUIRE_PLAN_APPROVAL=true
# Harness spend limits
VOICEFIRST_DAILY_SPEND_LIMIT_USD=25
VOICEFIRST_PER_RUN_TOKEN_LIMIT=200000
# Redact PII (emails, phones, SSNs, IPs, card numbers) from agent output.
# Also toggleable live via PATCH /api/policies (admin) — env wins on restart.
VOICEFIRST_REDACT_PII=false
# Max concurrent provider model requests shared across all agents
VOICEFIRST_MODEL_CONCURRENCY_LIMIT=16
# Per-agent ceiling on concurrent runs
VOICEFIRST_AGENT_MAX_CONCURRENCY=8
# Model reasoning effort: off | minimal | low | medium | high
VOICEFIRST_THINKING_LEVEL=off
# Provider-native web search/fetch upgrade for the Research agent (OpenAI/Google)
VOICEFIRST_NATIVE_WEB_TOOLS=true
# Harness capability flags (all safe defaults; each can be disabled)
VOICEFIRST_INJECTION_DEFENDER_ENABLED=true
VOICEFIRST_STEP_PERSISTENCE_ENABLED=true
VOICEFIRST_STEP_STORE_PATH=voicefirst_steps.db
VOICEFIRST_CACHE_BUST_MONITOR_ENABLED=true
VOICEFIRST_MEDIA_OFFLOAD_ENABLED=true
VOICEFIRST_MEDIA_OFFLOAD_THRESHOLD_BYTES=512000
VOICEFIRST_MEDIA_STORE_PATH=voicefirst_media
VOICEFIRST_CODE_MODE_ENABLED=true
# Second-model advisor for the orchestrator (advisor calls bill tokens)
VOICEFIRST_ADVISOR_ENABLED=true
#VOICEFIRST_ADVISOR_MODEL=openai:gpt-5-mini
# Agent-authored capabilities in Agent Studio (admin-gated at runtime)
VOICEFIRST_CAPABILITY_CREATION_ENABLED=false
VOICEFIRST_AUTHORED_CAPABILITIES_PATH=voicefirst_authored_capabilities

# --- Auth (Better Auth in the frontend) -------------------------------------
# betterauth : backend verifies browser JWTs against the frontend's JWKS
# disabled   : dev mode — trust X-VF-User / X-VF-Role headers
VOICEFIRST_AUTH_MODE=betterauth
VOICEFIRST_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
VOICEFIRST_AUTH_BASE_URL=http://localhost:3000/api/auth
VOICEFIRST_DEV_ROLE=admin

# --- Integrations (optional; enable real tool calls) ------------------------
VOICEFIRST_GITHUB_TOKEN=
VOICEFIRST_SLACK_BOT_TOKEN=
VOICEFIRST_MONGODB_URI=

# --- GitHub OAuth app (Settings → Integrations → Connect GitHub) ------------
# Lets each operator authorize the GitHub agent with their own account via the
# web flow; the exchanged token is stored server-side and used by the agent.
VOICEFIRST_GITHUB_CLIENT_ID=
VOICEFIRST_GITHUB_CLIENT_SECRET=
VOICEFIRST_GITHUB_OAUTH_RETURN_URL=http://localhost:3000/settings?github=connected

# --- MCP registry (optional remote MCP servers) -----------------------------
VOICEFIRST_GITHUB_MCP_URL=
VOICEFIRST_SLACK_MCP_URL=
VOICEFIRST_MONGODB_MCP_URL=

# --- Server / production hardening ------------------------------------------
VOICEFIRST_HOST=0.0.0.0
VOICEFIRST_PORT=8000
# Access log format: plain (human) or json (log shippers: OTel, Loki, Datadog)
VOICEFIRST_LOG_FORMAT=plain
VOICEFIRST_LOG_LEVEL=INFO
# Token-bucket rate limit per caller on /api/* (bearer-token hash or client IP)
VOICEFIRST_RATE_LIMIT_ENABLED=true
VOICEFIRST_RATE_LIMIT_PER_MINUTE=120
# Prometheus metrics at /metrics (request counters + latency histograms)
VOICEFIRST_METRICS_ENABLED=true
# HMAC secret for outbound webhooks (approvals, trigger results). When set,
# every webhook carries X-VoiceFirst-Signature: sha256=<hmac-of-body>.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
VOICEFIRST_WEBHOOK_SECRET=

# --- Key vault --------------------------------------------------------------
# Master key for encrypting user-supplied provider API keys (LLM Connections).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotating it invalidates stored connections.
VOICEFIRST_SECRET_KEY=
